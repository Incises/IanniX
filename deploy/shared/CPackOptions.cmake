get_filename_component(IANNIX_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)

set(IANNIX_PACKAGE_ARCH "${CMAKE_SYSTEM_PROCESSOR}")
set(IANNIX_DEBIAN_PACKAGE_ARCH "${CMAKE_SYSTEM_PROCESSOR}")

string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" IANNIX_PACKAGE_ARCH_LC)
if(IANNIX_PACKAGE_ARCH_LC MATCHES "^(x86_64|amd64)$")
    set(IANNIX_PACKAGE_ARCH "x86_64")
    set(IANNIX_DEBIAN_PACKAGE_ARCH "amd64")
elseif(IANNIX_PACKAGE_ARCH_LC MATCHES "^(aarch64|arm64)$")
    set(IANNIX_PACKAGE_ARCH "aarch64")
    set(IANNIX_DEBIAN_PACKAGE_ARCH "arm64")
endif()

set(CPACK_PACKAGE_NAME "IanniX")
set(CPACK_PACKAGE_VENDOR "IanniX Association")
set(CPACK_PACKAGE_CONTACT "https://iannix.org")
set(CPACK_PACKAGE_HOMEPAGE_URL "https://iannix.org")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Graphical real-time sequencer for digital art")
set(CPACK_PACKAGE_DIRECTORY "${IANNIX_SOURCE_DIR}/dist")
set(CPACK_PACKAGE_INSTALL_DIRECTORY "IanniX")
set(CPACK_RESOURCE_FILE_LICENSE "${IANNIX_SOURCE_DIR}/COPYING.txt")
set(CPACK_RESOURCE_FILE_README "${IANNIX_SOURCE_DIR}/README.md")

if(NOT DEFINED CPACK_GENERATOR)
    if(WIN32)
        set(CPACK_GENERATOR "NSIS;ZIP")
    elseif(UNIX AND NOT APPLE)
        set(CPACK_GENERATOR "DEB;RPM;TGZ")
    else()
        set(CPACK_GENERATOR "TGZ")
    endif()
endif()

if(WIN32)
    set(CPACK_PACKAGE_EXECUTABLES "IanniX" "IanniX")
    set(CPACK_NSIS_DISPLAY_NAME "IanniX")
    set(CPACK_NSIS_PACKAGE_NAME "IanniX")
    set(CPACK_NSIS_ENABLE_UNINSTALL_BEFORE_INSTALL ON)
    set(CPACK_NSIS_MUI_ICON "${IANNIX_SOURCE_DIR}/deploy/windows/icon.ico")
    set(CPACK_NSIS_MUI_UNIICON "${IANNIX_SOURCE_DIR}/deploy/windows/icon.ico")
    set(CPACK_NSIS_INSTALLED_ICON_NAME "IanniX.exe")
elseif(UNIX AND NOT APPLE)
    set(CPACK_DEBIAN_PACKAGE_MAINTAINER "IanniX Association")
    set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)
    set(CPACK_DEBIAN_PACKAGE_ARCHITECTURE "${IANNIX_DEBIAN_PACKAGE_ARCH}")
    set(CPACK_DEBIAN_PACKAGE_SECTION "sound")
    set(CPACK_RPM_FILE_NAME RPM-DEFAULT)
    set(CPACK_RPM_PACKAGE_ARCHITECTURE "${IANNIX_PACKAGE_ARCH}")
    set(CPACK_RPM_PACKAGE_LICENSE "GPL-3.0-or-later")
    set(CPACK_RPM_PACKAGE_GROUP "Applications/Multimedia")
    set(CPACK_PACKAGING_INSTALL_PREFIX "/usr")
endif()
